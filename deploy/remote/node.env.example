# Copy this file to deploy/remote/node.env (gitignored) and fill in the real values.
# Make and the shell both read this file, so keep it to plain KEY=value lines.
#
# HOST_ID    sqsh host identity: the host_id config value, the filter-policy value,
#            and the suffix of the queue names.
# NODE_SSH   SSH hostname or alias of the node.
# NODE_PORT  SSH port.
# NODE_KEY   path to the SSH private key.
# NODE_USER  login user on the node. The daemon runs as this user.
# NODE_HOME  that user's home directory on the node (holds .aws credentials).

HOST_ID=<host-id>
NODE_SSH=<node-ssh>
NODE_PORT=<node-ssh-port>
NODE_KEY=<node-ssh-key>
NODE_USER=<node-user>
NODE_HOME=/home/<node-user>
